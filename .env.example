#----------------------------------------------------------------------
# PostgreSQL databases
#----------------------------------------------------------------------
# Airflow metadata database name, user, and password.
AIRFLOW_DB=<airflow-database-name>
AIRFLOW_USER=<airflow-database-user>
AIRFLOW_PASSWORD=<airflow-database-password>

# Shop OLTP database name, user, and password.
SHOP_DB=<shop-database-name>
SHOP_USER=<shop-database-user>
SHOP_PASSWORD=<shop-database-password>

# SQLAlchemy URL used by Alembic and local development scripts to connect to
# the Shop database.
SHOP_DATABASE_URL=<sqlalchemy-url-for-shop-database>

#----------------------------------------------------------------------
# Python and Airflow
#----------------------------------------------------------------------
# Python source directory inside the Airflow container.
PYTHONPATH=<container-path-to-python-source>

# Airflow runtime paths inside the Airflow container.
AIRFLOW_HOME=<container-path-to-airflow-home>
AIRFLOW_CONFIG=<container-path-to-airflow-config-file>

# Airflow database URL for the remote/base Compose deployment.
# The local Compose override configures the metadata DB URL separately.
AIRFLOW_DATABASE_URL=<sqlalchemy-url-for-airflow-metadata-database>

# Airflow connection used by PostgresHook(postgres_conn_id="shop_postgres").
# Configure it to connect to the Shop database from the Airflow runtime.
AIRFLOW_CONN_SHOP_POSTGRES=<airflow-connection-uri-for-shop-postgres>

# Celery broker and result backend URLs.
AIRFLOW_CELERY_BROKER_URL=<celery-broker-url>
AIRFLOW_CELERY_RESULT_BACKEND=<celery-result-backend-url>

# URL workers use to reach the Airflow API server.
AIRFLOW_EXECUTION_API_URL=<airflow-execution-api-url>

# Shared secret for Airflow's API JWT signing. Replace with a unique,
# randomly generated secret; do not commit the real value.
AIRFLOW_JWT_SECRET=<generate-a-long-random-secret>

# Simple Auth Manager users in username:role format.
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=<username>:<airflow-role>

#----------------------------------------------------------------------
# Snowflake-compatible warehouse
#----------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=<warehouse-account>
SNOWFLAKE_USER=<warehouse-user>
SNOWFLAKE_PASSWORD=<warehouse-password>
SNOWFLAKE_DATABASE=<warehouse-database>
SNOWFLAKE_SCHEMA=<base-schema-name>
SNOWFLAKE_WAREHOUSE=<warehouse-name>
# Airflow Snowflake connection for the local Compose override. In this URI,
# /public sets the schema; database=memory is a query parameter. URL-encode
# credentials if they contain reserved characters.
AIRFLOW_CONN_DWH_SNOWFLAKE=snowflake://<user>:<password>@snowflake/public?host=snowflake&port=443&account=<account>&database=memory&warehouse=<warehouse>&insecure_mode=true
# Superset configures the DWH_SNOWFLAKE connection at startup from the settings
# above. The dashboard export's connection options target the local emulator.

# Set to true only when intentionally generating a baseline Alembic revision
# in a development environment. The initialization script reads this variable.
ALLOW_AUTOGENERATE=<true-or-false>

#----------------------------------------------------------------------
# Superset
#----------------------------------------------------------------------
# Python packages installed in the Superset image, separated by spaces.
SUPERSET_ADDITIONAL_REQUIREMENTS=<space-separated-python-package-names>

SUPERSET_ADMIN_EMAIL=<superset-admin-email>
SUPERSET_ADMIN_FIRSTNAME=<superset-admin-first-name>
SUPERSET_ADMIN_LASTNAME=<superset-admin-last-name>
SUPERSET_ADMIN_USERNAME=<superset-admin-username>
SUPERSET_ADMIN_PASSWORD=<superset-admin-password>
# Use a long, randomly generated private key; do not use this placeholder.
SUPERSET_SECRET_KEY=<generate-a-long-random-secret>

#----------------------------------------------------------------------
# Data lake
#----------------------------------------------------------------------
# Container mount path for the host's local data lake directory.
DATALAKE_ROOT_PATH=<container-path-to-datalake-root>

# Directory names for extracted, reference-catalog, staging, and Gold data.
DATALAKE_BRONZE_AREA=<bronze-area-directory-name>
DATALAKE_SILVER_AREA=<silver-reference-area-directory-name>
DATALAKE_STAGING_AREA=<staging-area-directory-name>
DATALAKE_GOLD_AREA=<gold-area-directory-name>

# Maximum rows fetched from the Shop database per extraction batch.
EXTRACT_CHUNK_SIZE=<positive-row-count>

# Maximum percentage of extracted orders allowed to be quarantined before the
# daily ETL fails.
MAX_ALLOWED_ANOMALY_RATE=<percentage-from-0-to-100>

# Demonstration-only estimated VAT fraction; replace with jurisdiction-aware
# tax logic for a real shop.
ESTIMATED_VAT_RATE=<fraction-from-0-to-1>

#----------------------------------------------------------------------
# ML models
#----------------------------------------------------------------------
# Shared directory for trained ONNX artifacts and the SentenceTransformer
# download cache. Configure it under the shared project mount.
ML_MODEL_DIR=<container-path-for-shared-ml-models>

# ONNX model artifact names saved under ML_MODEL_DIR.
ANOMALY_ISOLATION_MODEL=<anomaly-detection-model-filename>
FRAUD_DETECTION_MODEL=<fraud-detection-model-filename>

# Default fraud probability threshold (0-1) used when triggering model
# training; a DAG run can override it.
FRAUD_RISK_THRESHOLD=<probability-from-0-to-1>

# Hugging Face model ID used for product-description embeddings.
SEMANTIC_MODEL=<huggingface-sentence-transformer-model-id>
# Optional Hugging Face token; only needed for gated/private models or rate limits.
HF_TOKEN=<optional-huggingface-token>
